PORT=10000
FRONTEND_URL=http://localhost:4300
# Orígenes que pueden llamar a la API (separados por coma; FRONTEND_URL se agrega solo)
CORS_ORIGINS=http://localhost:4300,https://toolbox-frontend.onrender.com
# true en producción: los routers protegidos exigen JWT de Supabase.
# false (default) permite los paneles demo sin login (solo desarrollo).
EXIGIR_JWT=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Clave de OpenRouter para la extracción de Cédula Verde por visión
OPENROUTER_API_KEY=sk-or-v1-...
EVOLUTION_API_ENDPOINT=https://your-evolution-api.com
EVOLUTION_API_TOKEN=your-evolution-token
